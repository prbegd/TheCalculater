[settings]
arch=x86_64
build_type=Release
compiler=clang
compiler.cppstd=gnu17
compiler.libcxx=libstdc++11
compiler.version=@THIRDPARTY_CLANG_VERSION_MAJOR@
os=Linux

[buildenv]
CC=@THIRDPARTY_CLANG_EXECUTABLE@
CXX=@THIRDPARTY_CLANGXX_EXECUTABLE@
CXXFLAGS=-fPIC
CFLAGS=-fPIC

[conf]
tools.system.package_manager:mode=install
tools.system.package_manager:sudo=True
