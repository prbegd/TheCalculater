[settings]
arch=armv8
build_type=Release
compiler=clang
compiler.cppstd=gnu26
compiler.libcxx=libc++
compiler.version=@THIRDPARTY_CLANG_VERSION_MAJOR@
os=Macos

[buildenv]
CC=@THIRDPARTY_CLANG_EXECUTABLE@
CXX=@THIRDPARTY_CLANGXX_EXECUTABLE@
