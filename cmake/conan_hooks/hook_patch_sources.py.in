from conan import ConanFile
from conan.tools.files import patch
import os

_script = os.path.basename(__file__)

def _applyPatches(conanfile: ConanFile, patchesDir: str):
    recipePatchesDir = None
    with os.scandir(patchesDir) as entries:
        for entry in entries:
            if entry.is_dir() and entry.name == f"{conanfile.name}-{conanfile.version}":
                recipePatchesDir = entry.path
    if recipePatchesDir == None:
        return
    appliedCount: int = 0
    try:
        with os.scandir(recipePatchesDir) as entries:
            for entry in entries:
                if entry.is_file() and entry.name.endswith((".patch", ".diff")):
                    print(f"{_script}: Applying patch '{entry.name}'")
                    patch(conanfile, patch_file=entry.path)
                    appliedCount += 1
    finally:
        print(f"{_script}: Applied {appliedCount} patch(es) for recipe {conanfile.name}/{conanfile.version}")

def post_source(conanfile: ConanFile):
    recipePatchesDir: str = "@RECIPE_PATCHES_DIR@"
    _applyPatches(conanfile, recipePatchesDir)
    
