{
    calculating: {
        type: "namespace",
        name: "TheCalculater.settings.calculating",
        children: {
            pi: {
                type: "decimal",
                default: "3.14159265358979",
                min: 3,
                max: 4,
                description: "TheCalculater.settings.calculating.pi.desc",
                warning: "TheCalculater.settings.calculating.pi.warn",
                name: "TheCalculater.settings.calculating.pi.name",
            }
        }
    }
}